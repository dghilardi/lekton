# Lekton service configuration, read by lekton.service.
#
# Every setting is an LKN__<SECTION>__<KEY> variable (see config/default.toml in
# the source tree for the full list). Restart the service after editing:
#   sudo systemctl restart lekton
#
# Do not put comments at the end of a value line: systemd keeps them as part
# of the value.

# Address the server listens on (put a reverse proxy with TLS in front of it).
LEPTOS_SITE_ADDR=127.0.0.1:3000

# ── Database ────────────────────────────────────────────────────────────────────
LKN__DATABASE__URI=mongodb://localhost:27017
LKN__DATABASE__NAME=lekton

# ── S3 storage (credentials use the standard AWS_* variables) ─────────────────
# LKN__STORAGE__BUCKET=lekton-docs
# LKN__STORAGE__ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Authentication ────────────────────────────────────────────────────────────
# LKN__AUTH__SERVICE_TOKEN=
# LKN__AUTH__JWT_SECRET=
# LKN__AUTH__CLIENT_ID=
# LKN__AUTH__CLIENT_SECRET=
# LKN__AUTH__REDIRECT_URI=https://docs.example.com/auth/callback

# ── Optional services ─────────────────────────────────────────────────────────
# LKN__FEATURES__SEARCH=true
# LKN__SEARCH__URL=http://localhost:7700
# LKN__SEARCH__API_KEY=
